{
  "extends": "./node_modules/@microsoft/rush-stack-compiler-4.7/includes/tsconfig-web.json",
  "compilerOptions": {
    "target": "es6",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react",
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "outDir": "lib",
    "inlineSources": false,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/@microsoft",
      "./src"
    ],
    "types": [
      "webpack-env"
    ],
    "lib": [
      "es5",
      "es2018",
      "es2017",
      "es2017.string",
      "dom",
      "es2015.collection",
      "es2015.promise"
    ],
    "strict": true,
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}